# ---------------------------------------------------------------------------
# Unify Wi-Fi — environment variables
#
# Copy to `.env.local` for local development. NOTHING in this file is required
# for the site to build or render: every integration below is absent by design
# until real credentials are issued.
#
# Integration status contract (see also: lib/notify/*):
#   credentials present  -> the feature runs live and the UI says so
#   credentials absent   -> the feature runs in DEMO mode, the UI says so, and
#                           nothing is silently presented as a real delivery
# ---------------------------------------------------------------------------

# Public site origin. Used for canonical URLs, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://unify.thewify.com

# ── Phase 8: transactional email — Resend ───────────────────────────────────
# Resend API key. Get from https://resend.com/api-keys
# Required for live email sends. Absent → DEMO mode (nothing sent).
RESEND_API_KEY=

# Verified sender address. Must belong to a domain verified in the Resend dashboard.
# IMPORTANT: do not guess an unverified address — Resend will reject it.
# Recommended: noreply@thewify.com (verify thewify.com in Resend first).
EMAIL_FROM=

# Lead notification recipients — comma-separated internal email addresses.
# Leave empty to use the approved defaults: anusha, Subbu, rakesh @thewify.com
# Example: LEAD_NOTIFY_TO=anusha@thewify.com,Subbu@thewify.com,rakesh@thewify.com
LEAD_NOTIFY_TO=

# ── Phase 8: Google Calendar + Google Meet (demo slot booking) ───────────────
# All three must be present for live calendar events and Meet links.
# Absent → DEMO mode (no event created, no Meet link, UI clearly says so).
#
# Setup steps (one-time, in Google Cloud Console):
#   1. Create a project → enable the Google Calendar API
#   2. Create a Service Account → download the JSON key file
#   3. Share the target calendar with the service account email (Editor role)
#   4. Copy the values from the JSON key file into the vars below
#
# The calendar that receives bookings (share this with the service account):
GOOGLE_CALENDAR_ID=

# service_account_email from the downloaded JSON key file:
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# private_key from the JSON key file.
# Paste the full -----BEGIN RSA PRIVATE KEY----- block.
# In .env.local you may use literal \n sequences or a real multi-line value.
# Example (single line with \n):
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Phase 8: WhatsApp confirmations (provider + template PENDING) ───────────
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_FROM_NUMBER=
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=

# ── Phase 8: form abuse protection ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Phase 10: analytics (Consent Mode v2, denied by default) ───────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
